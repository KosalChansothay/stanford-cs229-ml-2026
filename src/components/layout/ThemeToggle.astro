---
// Minimalist Zero-Emoji Theme Toggle (Multi-instance safe with Timezone Auto Day/Night)
---

<button class="theme-toggle" aria-label="Toggle dark/light theme" title="Toggle theme (Auto: Light 6AM–6PM, Dark 6PM–6AM)" type="button">
  <!-- Sun Icon (shown in dark mode) -->
  <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>

  <!-- Moon Icon (shown in light mode) -->
  <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .theme-toggle:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    transform: scale(1.05);
  }

  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }

  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }
</style>

<script is:inline>
  // Universal Theme Initializer & Event Binding across all instances
  (() => {
    const getAutoTheme = () => {
      const hour = new Date().getHours();
      return (hour >= 6 && hour < 18) ? 'light' : 'dark';
    };

    const applyTheme = (theme, isManual = true) => {
      document.documentElement.setAttribute('data-theme', theme);
      if (isManual) {
        try {
          sessionStorage.setItem('theme_manual', theme);
          localStorage.setItem('theme', theme);
        } catch (e) {}
      }
      document.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme } }));
    };

    // Attach listener to all theme toggle buttons on the page
    const bindToggles = () => {
      const buttons = document.querySelectorAll('.theme-toggle');
      buttons.forEach((btn) => {
        // Prevent duplicate bindings
        if (btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';

        btn.addEventListener('click', () => {
          const currentTheme = document.documentElement.getAttribute('data-theme') || getAutoTheme();
          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          const autoTheme = getAutoTheme();

          if (nextTheme === autoTheme) {
            // Revert back to automatic schedule mode
            try {
              sessionStorage.removeItem('theme_manual');
              localStorage.removeItem('theme');
            } catch (e) {}
            applyTheme(nextTheme, false);
          } else {
            applyTheme(nextTheme, true);
          }
        });
      });
    };

    // Auto theme scheduler: automatically transitions when crossing 6am / 6pm if no manual override
    const checkSchedule = () => {
      try {
        if (sessionStorage.getItem('theme_manual')) return;
      } catch (e) {}
      const expected = getAutoTheme();
      const current = document.documentElement.getAttribute('data-theme');
      if (current !== expected) {
        applyTheme(expected, false);
      }
    };

    // Check periodically every minute and on visibility change
    setInterval(checkSchedule, 60000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        checkSchedule();
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindToggles);
    } else {
      bindToggles();
    }
  })();
</script>
