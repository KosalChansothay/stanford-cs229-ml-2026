---
// Persistent Left Sidebar with Course Accordions (Strict Zero-Emoji)
import ThemeToggle from './ThemeToggle.astro';
import { cs229LecturesList, cs336LecturesList, cs231nLecturesList } from '../../data/lectures';

interface Props {
  currentCourse?: string;
  currentLecture?: string;
  lang?: 'en' | 'km';
}

const { currentCourse = '', currentLecture = '', lang = 'en' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Dynamic target language URL calculation for lower-left language switcher
const targetLangUrl = (currentCourse === 'cs229' && currentLecture)
  ? (lang === 'en' ? `${baseUrl}/km/courses/cs229/${currentLecture}/` : `${baseUrl}/courses/cs229/${currentLecture}/`)
  : (lang === 'en' ? `${baseUrl}/km/` : `${baseUrl}/`);
---

<aside id="app-sidebar" class="app-sidebar">
  <div class="sidebar-header">
    <div class="sidebar-header-main">
      <a href={`${baseUrl}/`} class="sidebar-brand">
        <div class="sidebar-avatar-wrapper">
          <div class="sidebar-avatar-inner">
            <img 
              src={`${baseUrl}/img/profile.jpg`} 
              alt="Author Portrait" 
              class="sidebar-avatar" 
              width="40" 
              height="40" 
              loading="eager"
            />
          </div>
        </div>
        <div class="brand-text">
          <span class="brand-title">Frontier AI Series</span>
          <span class="brand-subtitle">Stanford • MIT • Top Curricula</span>
        </div>
      </a>
      <button id="sidebar-collapse-btn" class="sidebar-collapse-btn" type="button" aria-label="Collapse sidebar" title="Collapse sidebar (Ctrl+B)">
        <svg class="collapse-icon-desktop" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <svg class="close-icon-mobile" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="sidebar-nav-section">
    <nav class="sidebar-top-nav">
      <a href={`${baseUrl}/`} class={`nav-link ${!currentCourse ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Curriculum Portal</span>
      </a>

      <a href={`${baseUrl}/notes/`} class={`nav-link ${currentCourse === 'catalog' ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span>All 50+ Lecture Notes</span>
      </a>

      <a href={`${baseUrl}/bookmarks/`} class={`nav-link ${currentCourse === 'bookmarks' ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Saved Bookmarks</span>
        <span id="sidebar-bookmark-count" class="sidebar-bookmark-badge">0</span>
      </a>
    </nav>
  </div>

  <!-- Course Accordions List -->
  <div class="sidebar-courses-section">
    <div class="section-label">COURSE TRACKS</div>

    <!-- Accordion 1: CS229 -->
    <details class="course-accordion" open={currentCourse === 'cs229'}>
      <summary class="accordion-summary">
        <div class="summary-left">
          <span class="track-dot dot-cs229"></span>
          <span class="course-name">CS229: Machine Learning</span>
        </div>
        <div class="summary-right">
          <span class="lecture-badge">{cs229LecturesList.length}</span>
          <svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </summary>
      <div class="accordion-content">
        <ul class="lecture-list">
          {cs229LecturesList.map((item) => (
            <li>
              <a 
                href={`${baseUrl}/courses/cs229/${item.slug}/`} 
                class={`lecture-link ${currentCourse === 'cs229' && currentLecture === item.slug ? 'active' : ''}`}
              >
                <span class="lecture-number">L{item.order}</span>
                <span class="lecture-title">{item.shortTitle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <!-- Accordion 2: CS336 -->
    <details class="course-accordion" open={currentCourse === 'cs336'}>
      <summary class="accordion-summary">
        <div class="summary-left">
          <span class="track-dot dot-cs336"></span>
          <span class="course-name">CS336: Frontier LLMs</span>
        </div>
        <div class="summary-right">
          <span class="lecture-badge">{cs336LecturesList.length}</span>
          <svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </summary>
      <div class="accordion-content">
        <ul class="lecture-list">
          {cs336LecturesList.map((item) => (
            <li>
              <a 
                href={`${baseUrl}/courses/cs336/${item.slug}/`} 
                class={`lecture-link ${currentCourse === 'cs336' && currentLecture === item.slug ? 'active' : ''}`}
              >
                <span class="lecture-number">{item.slug === 'lecture-guest' ? 'GL' : `L${item.order}`}</span>
                <span class="lecture-title">{item.shortTitle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <!-- Accordion 3: CS231N -->
    <details class="course-accordion" open={currentCourse === 'cs231n'}>
      <summary class="accordion-summary">
        <div class="summary-left">
          <span class="track-dot dot-cs231n"></span>
          <span class="course-name">CS231N: Vision &amp; 3D</span>
        </div>
        <div class="summary-right">
          <span class="lecture-badge">{cs231nLecturesList.length}</span>
          <svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </summary>
      <div class="accordion-content">
        <ul class="lecture-list">
          {cs231nLecturesList.map((item) => (
            <li>
              <a 
                href={`${baseUrl}/courses/cs231n/${item.slug}/`} 
                class={`lecture-link ${currentCourse === 'cs231n' && currentLecture === item.slug ? 'active' : ''}`}
              >
                <span class="lecture-number">L{item.order}</span>
                <span class="lecture-title">{item.shortTitle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>
  </div>

  <div class="sidebar-footer">
    <div class="footer-links">
      <a href="https://github.com/KosalChansothay/stanford-cs229-ml-2026" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="GitHub Repository" title="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
      </a>
      <span class="footer-version">Spring 2026</span>
    </div>

    <div class="footer-actions">
      <!-- Lower-Left Language Switcher -->
      <a 
        id="sidebar-lang-switch"
        href={targetLangUrl}
        class="sidebar-lang-btn"
        title={lang === 'en' ? 'ប្តូរទៅភាសាខ្មែរ (Switch to Khmer)' : 'Switch to English'}
        aria-label="Switch Language"
        data-base={baseUrl}
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class={`sidebar-lang-text ${lang === 'en' ? 'khmer-label' : ''}`}>{lang === 'en' ? 'ភាសាខ្មែរ' : 'English'}</span>
      </a>

      <!-- Theme Toggle (Auto Day/Night) -->
      <ThemeToggle />
    </div>
  </div>
</aside>

<style>
  .app-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--sidebar-width);
    background: var(--bg-secondary);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    z-index: 100;
    overflow-y: auto;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 1024px) {
    .app-sidebar {
      transform: translateX(-100%);
      box-shadow: var(--shadow-card);
    }

    .app-sidebar.drawer-open {
      transform: translateX(0);
    }
  }

  .sidebar-header {
    padding: 1rem 1rem 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .sidebar-header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    flex-wrap: nowrap;
  }

  .sidebar-collapse-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--card-surface-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
    padding: 0;
  }

  .sidebar-collapse-btn:hover {
    background: var(--card-surface-hover);
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .collapse-icon-desktop {
    display: block !important;
  }

  .close-icon-mobile {
    display: none !important;
  }

  @media (max-width: 1024px) {
    .collapse-icon-desktop {
      display: none !important;
    }
    .close-icon-mobile {
      display: block !important;
    }
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    min-width: 0;
    flex: 1;
    overflow: hidden;
  }

  .sidebar-avatar-wrapper {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    padding: 2.5px;
    background: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.22);
    flex-shrink: 0;
    margin: 2px 2px 2px 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global([data-theme="dark"]) .sidebar-avatar-wrapper {
    background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 50%, #06b6d4 100%);
    box-shadow: 0 2px 12px rgba(59, 130, 246, 0.3);
  }

  .sidebar-brand:hover .sidebar-avatar-wrapper {
    transform: scale(1.06);
    background: linear-gradient(135deg, #1d4ed8 0%, #06b6d4 100%);
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.4);
  }

  .sidebar-avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-secondary);
    border: 2px solid var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sidebar-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 18%;
    border-radius: 50%;
    display: block;
  }

  .sidebar-bookmark-badge {
    margin-left: auto;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--card-surface-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    line-height: 1.2;
    transition: all 0.15s ease;
  }

  .nav-link.active .sidebar-bookmark-badge {
    background: var(--brand-accent);
    color: #ffffff;
    border-color: var(--brand-accent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    overflow: hidden;
  }

  .brand-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-subtitle {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-nav-section {
    padding: 1rem 0.85rem 0.5rem;
  }

  .sidebar-top-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.85rem;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: all 0.15s ease;
  }

  .nav-link:hover {
    background: var(--card-surface-subtle);
    color: var(--text-primary);
  }

  .nav-link.active {
    background: var(--brand-accent-glow);
    color: var(--brand-accent);
  }

  .sidebar-courses-section {
    flex: 1;
    padding: 0.75rem 0.85rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 0.25rem 0.85rem 0.5rem;
  }

  /* Accordion Styles */
  .course-accordion {
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    background: var(--card-surface);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .course-accordion[open] {
    border-color: var(--border-strong);
  }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0.85rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background 0.15s ease;
  }

  .accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-summary:hover {
    background: var(--card-surface-subtle);
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .track-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-cs229 { background: #8C1515; }
  .dot-cs336 { background: #6366F1; }
  .dot-cs231n { background: #06B6D4; }

  .course-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .lecture-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: var(--radius-pill);
    background: var(--card-surface-subtle);
    color: var(--text-secondary);
  }

  .chevron-icon {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }

  .course-accordion[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .accordion-content {
    padding: 0.25rem 0.5rem 0.5rem;
    border-top: 1px solid var(--border-subtle);
    max-height: 280px;
    overflow-y: auto;
  }

  .lecture-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lecture-link {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
    font-size: 0.76rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.12s ease;
  }

  .lecture-link:hover {
    background: var(--card-surface-subtle);
    color: var(--text-primary);
  }

  .lecture-link.active {
    background: var(--brand-accent-glow);
    color: var(--brand-accent);
    font-weight: 600;
  }

  .lecture-number {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .lecture-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-footer {
    padding: 0.75rem 0.95rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .footer-icon-link:hover {
    color: var(--text-primary);
  }

  .footer-version {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .sidebar-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 0.65rem;
    height: 38px;
    border-radius: var(--radius-pill);
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .sidebar-lang-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: var(--card-surface-subtle);
    transform: scale(1.03);
  }

  .sidebar-lang-btn:active {
    transform: scale(0.98);
  }

  .sidebar-lang-text {
    line-height: 1;
  }
</style>

<script is:inline>
  (() => {
    // 1. Global sidebar toggle handler
    const toggleSidebar = () => {
      const isMobile = window.innerWidth <= 1024;
      const sidebar = document.getElementById('app-sidebar');
      const backdrop = document.getElementById('drawer-backdrop');

      if (isMobile) {
        if (sidebar && sidebar.classList.contains('drawer-open')) {
          sidebar.classList.remove('drawer-open');
          if (backdrop) backdrop.classList.remove('active');
          document.body.style.overflow = '';
        } else if (sidebar) {
          sidebar.classList.add('drawer-open');
          if (backdrop) backdrop.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      } else {
        const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
        try {
          localStorage.setItem('sidebar_collapsed', isCollapsed ? 'true' : 'false');
        } catch (e) {}
        window.dispatchEvent(new CustomEvent('sidebar:statechange', { detail: { collapsed: isCollapsed } }));
      }
    };

    const attachToggles = () => {
      const collapseBtn = document.getElementById('sidebar-collapse-btn');
      if (collapseBtn) collapseBtn.addEventListener('click', toggleSidebar);

      const desktopToggle = document.getElementById('desktop-sidebar-toggle-btn');
      if (desktopToggle) desktopToggle.addEventListener('click', toggleSidebar);

      const lectureToggle = document.getElementById('lecture-sidebar-toggle-btn');
      if (lectureToggle) lectureToggle.addEventListener('click', toggleSidebar);
    };

    // Keyboard shortcuts: Ctrl+B or Cmd+B, '[' to toggle, Escape to close mobile drawer
    window.addEventListener('keydown', (e) => {
      const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
      if (tag === 'input' || tag === 'textarea' || (e.target && e.target.isContentEditable)) {
        return;
      }

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
        e.preventDefault();
        toggleSidebar();
      } else if (e.key === '[' && !e.ctrlKey && !e.metaKey && !e.altKey) {
        e.preventDefault();
        toggleSidebar();
      } else if (e.key === 'Escape' && window.innerWidth <= 1024) {
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('drawer-backdrop');
        if (sidebar && sidebar.classList.contains('drawer-open')) {
          sidebar.classList.remove('drawer-open');
          if (backdrop) backdrop.classList.remove('active');
          document.body.style.overflow = '';
        }
      }
    });

    // 2. Bookmarks Counter Sync
    const updateCount = () => {
      const badge = document.getElementById('sidebar-bookmark-count');
      if (!badge) return;
      try {
        const raw = localStorage.getItem('frontier_ai_bookmarks') || localStorage.getItem('stanford_ml_bookmarks');
        const list = raw ? JSON.parse(raw) : [];
        badge.textContent = Array.isArray(list) ? list.length : 0;
      } catch (e) {
        badge.textContent = '0';
      }
    };

    // 3. Dynamic Sidebar Language Switch Target Resolver
    const updateSidebarLangLink = () => {
      const btn = document.getElementById('sidebar-lang-switch');
      if (!btn) return;
      const path = window.location.pathname;
      const base = (btn.getAttribute('data-base') || '').replace(/\/$/, '');
      const isKm = path.includes('/km/') || path.endsWith('/km');

      const lectureMatch = path.match(/courses\/cs229\/(lecture-[\w-]+)/);
      if (lectureMatch) {
        const slug = lectureMatch[1];
        btn.href = isKm ? `${base}/courses/cs229/${slug}/` : `${base}/km/courses/cs229/${slug}/`;
      } else {
        btn.href = isKm ? `${base}/` : `${base}/km/`;
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        attachToggles();
        updateCount();
        updateSidebarLangLink();
      });
    } else {
      attachToggles();
      updateCount();
      updateSidebarLangLink();
    }

    document.addEventListener('bookmarks:updated', updateCount);
    window.addEventListener('storage', updateCount);
  })();
</script>

