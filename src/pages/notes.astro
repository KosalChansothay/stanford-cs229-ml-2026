---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allLecturesList } from '../data/lectures';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="All 50+ Lecture Notes & Derivations — Frontier AI Series"
  description="Search and explore all 50+ lecture notes and mathematical derivations across Stanford, MIT, and frontier AI curricula."
  currentCourse="catalog"
>
  <header class="catalog-header">
    <div class="header-eyebrow">CURRICULUM ARCHIVE • SPRING 2026</div>
    <h1 class="header-headline">All 50+ Lecture Notes</h1>
    <p class="header-subtext">
      Access the complete catalog of comprehensive study notes, rigorous proofs, and architecture blueprints.
    </p>

    <!-- Search Bar & Filters -->
    <div class="catalog-controls">
      <div class="search-input-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="notes-search-input" 
          class="notes-search-input" 
          placeholder="Search by topic, keyword, or lecture title..." 
          aria-label="Search lecture notes"
        />
      </div>

      <div class="filter-pills-row" id="catalog-filter-pills">
        <button class="filter-pill active" data-filter="all">All ({allLecturesList.length})</button>
        <button class="filter-pill" data-filter="cs229">CS229 (14)</button>
        <button class="filter-pill" data-filter="cs336">CS336 (18)</button>
        <button class="filter-pill" data-filter="cs231n">CS231N (18)</button>
        <button class="filter-pill" data-filter="bookmarked" id="filter-pill-bookmarks">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
          Bookmarks (<span id="bookmark-filter-count">0</span>)
        </button>
      </div>
    </div>
  </header>

  <!-- Lecture Grid -->
  <section class="catalog-grid" id="catalog-grid">
    {allLecturesList.map((item) => (
      <div 
        class="catalog-item-card" 
        data-course={item.courseCode}
        data-slug={item.slug}
        data-key={`${item.courseCode}/${item.slug}`}
        data-title={`${item.title} ${item.shortTitle}`.toLowerCase()}
      >
        <div class="card-top-row">
          <div class="card-badges">
            <span class="course-capsule" style={`background: ${item.courseColor}18; color: ${item.courseColor}; border: 1px solid ${item.courseColor}40;`}>
              {item.courseCode.toUpperCase()}
            </span>
            <span class="lecture-slug-tag">{item.slug.toUpperCase().replace('-', ' ')}</span>
          </div>

          <!-- Quick Bookmark Button on Card -->
          <button 
            type="button" 
            class="card-bookmark-btn" 
            aria-label="Bookmark lecture" 
            data-key={`${item.courseCode}/${item.slug}`}
            data-course={item.courseCode}
            data-slug={item.slug}
            data-title={item.title}
            data-url={`${baseUrl}${item.url}`}
          >
            <svg class="bm-icon-empty" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
            <svg class="bm-icon-filled" viewBox="0 0 24 24" width="16" height="16" fill="#F59E0B" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
          </button>
        </div>

        <a href={`${baseUrl}${item.url}`} class="card-content-link">
          <h3 class="catalog-card-title">{item.shortTitle}</h3>
          <p class="catalog-card-course">{item.courseName}</p>
        </a>

        <div class="card-bottom-row">
          <a href={`${baseUrl}${item.url}`} class="read-notes-link">
            <span>Read Study Notes</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    ))}
  </section>

  <!-- Empty state -->
  <div id="no-results-msg" class="no-results-box" style="display: none;">
    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.75rem; opacity: 0.4;">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <p class="no-results-title">No lectures matched your query</p>
    <p class="no-results-sub">Try adjusting your search terms or clearing the active filters.</p>
  </div>
</BaseLayout>

<style>
  .catalog-header {
    margin-bottom: 2.5rem;
  }

  .header-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .header-headline {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.15;
    margin-bottom: 0.6rem;
  }

  @media (max-width: 640px) {
    .header-headline {
      font-size: 1.85rem;
    }
  }

  .header-subtext {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin-bottom: 1.75rem;
  }

  .catalog-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-input-wrapper {
    position: relative;
    max-width: 580px;
  }

  .search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .notes-search-input {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.8rem;
    border-radius: var(--radius-pill);
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--text-primary);
    box-shadow: var(--shadow-subtle);
    outline: none;
    transition: all 0.2s ease;
  }

  .notes-search-input:focus {
    border-color: var(--brand-accent);
    box-shadow: 0 0 0 3px var(--brand-accent-glow);
  }

  .filter-pills-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-pill:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .filter-pill.active {
    background: var(--brand-accent);
    color: #ffffff;
    border-color: var(--brand-accent);
    box-shadow: var(--shadow-glow);
  }

  /* Grid of cards */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 1100px) {
    .catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .catalog-grid {
      grid-template-columns: 1fr;
    }
  }

  .catalog-item-card {
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .catalog-item-card:hover {
    border-color: var(--brand-accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .card-badges {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .course-capsule {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .lecture-slug-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .card-bookmark-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .card-bookmark-btn:hover {
    color: #F59E0B;
    transform: scale(1.15);
  }

  .card-bookmark-btn .bm-icon-filled {
    display: none;
  }

  .card-bookmark-btn.is-bookmarked .bm-icon-empty {
    display: none;
  }

  .card-bookmark-btn.is-bookmarked .bm-icon-filled {
    display: block;
  }

  .card-content-link {
    text-decoration: none;
    display: block;
  }

  .catalog-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: 0.35rem;
    transition: color 0.15s ease;
  }

  .card-content-link:hover .catalog-card-title {
    color: var(--brand-accent);
  }

  .catalog-card-course {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .card-bottom-row {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
  }

  .read-notes-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--brand-accent);
    text-decoration: none;
  }

  .read-notes-link svg {
    transition: transform 0.15s ease;
  }

  .catalog-item-card:hover .read-notes-link svg {
    transform: translateX(3px);
  }

  .no-results-box {
    text-align: center;
    padding: 3.5rem 1rem;
    color: var(--text-muted);
  }

  .no-results-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .no-results-sub {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('notes-search-input');
    const filterButtons = document.querySelectorAll('#catalog-filter-pills .filter-pill');
    const cards = document.querySelectorAll('.catalog-item-card');
    const noResults = document.getElementById('no-results-msg');
    const bookmarkCountSpan = document.getElementById('bookmark-filter-count');

    let currentFilter = 'all';
    let searchQuery = '';

    // Bookmark Helper Functions
    const getBookmarks = () => {
      try {
        const raw = localStorage.getItem('frontier_ai_bookmarks') || localStorage.getItem('stanford_ml_bookmarks');
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    };

    const saveBookmarks = (items) => {
      try {
        localStorage.setItem('frontier_ai_bookmarks', JSON.stringify(items));
        localStorage.setItem('stanford_ml_bookmarks', JSON.stringify(items));
        document.dispatchEvent(new CustomEvent('bookmarks:updated', { detail: { bookmarks: items } }));
      } catch (e) {}
    };

    const isBookmarked = (key) => {
      const bms = getBookmarks();
      return bms.some(b => b.key === key);
    };

    const syncBookmarkButtons = () => {
      const bms = getBookmarks();
      if (bookmarkCountSpan) bookmarkCountSpan.textContent = bms.length;

      document.querySelectorAll('.card-bookmark-btn').forEach((btn) => {
        const key = btn.getAttribute('data-key');
        if (bms.some(b => b.key === key)) {
          btn.classList.add('is-bookmarked');
          btn.setAttribute('title', 'Remove bookmark');
        } else {
          btn.classList.remove('is-bookmarked');
          btn.setAttribute('title', 'Bookmark this lecture');
        }
      });
    };

    const applyFilters = () => {
      const bms = getBookmarks();
      const bmKeys = new Set(bms.map(b => b.key));
      let visibleCount = 0;

      cards.forEach((card) => {
        const course = card.getAttribute('data-course');
        const key = card.getAttribute('data-key');
        const title = card.getAttribute('data-title') || '';

        let matchesFilter = false;
        if (currentFilter === 'all') {
          matchesFilter = true;
        } else if (currentFilter === 'bookmarked') {
          matchesFilter = bmKeys.has(key);
        } else {
          matchesFilter = (course === currentFilter);
        }

        const matchesSearch = !searchQuery || title.includes(searchQuery) || course.includes(searchQuery);

        if (matchesFilter && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    // Card bookmark button click handling
    document.querySelectorAll('.card-bookmark-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const key = btn.getAttribute('data-key');
        const course = btn.getAttribute('data-course');
        const slug = btn.getAttribute('data-slug');
        const title = btn.getAttribute('data-title');
        const url = btn.getAttribute('data-url');

        let bms = getBookmarks();
        const existingIdx = bms.findIndex(b => b.key === key);

        if (existingIdx !== -1) {
          bms.splice(existingIdx, 1);
        } else {
          bms.push({ key, course, slug, title, url, timestamp: Date.now() });
        }

        saveBookmarks(bms);
        syncBookmarkButtons();
        if (currentFilter === 'bookmarked') applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        applyFilters();
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    document.addEventListener('bookmarks:updated', () => {
      syncBookmarkButtons();
      if (currentFilter === 'bookmarked') applyFilters();
    });

    syncBookmarkButtons();
    applyFilters();
  });
</script>
