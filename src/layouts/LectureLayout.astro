---
import Sidebar from '../components/layout/Sidebar.astro';
import MobileTopbar from '../components/layout/MobileTopbar.astro';
import ThemeToggle from '../components/layout/ThemeToggle.astro';
import '../styles/global.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  courseCode: 'cs229' | 'cs336' | 'cs231n';
  courseName: string;
  lectureSlug: string;
  lectureTitle: string;
  headings: Heading[];
  prevLecture?: { slug: string; title: string } | null;
  nextLecture?: { slug: string; title: string } | null;
  lang?: 'en' | 'km';
  hasKm?: boolean;
}

const {
  title,
  courseCode,
  courseName,
  lectureSlug,
  lectureTitle,
  headings = [],
  prevLecture = null,
  nextLecture = null,
  lang = 'en',
  hasKm = false
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const filterHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

const lectureUrl = `${baseUrl}/courses/${courseCode}/${lectureSlug}/`;
const bookmarkKey = `${courseCode}-${lectureSlug}`;

// Normalized chart script filename (e.g. cs336-lecture3-charts.js)
const chartScriptUrl = `${baseUrl}/js/${courseCode}/${courseCode}-${lectureSlug.replace('-', '')}-charts.js`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Frontier AI Series</title>
    <meta name="description" content={`Rigorous study notes for ${courseName}, ${lectureTitle}. Comprehensive mathematical formulations, proofs, and modern AI paradigms.`} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Synchronous Early Theme & Sidebar Initialization (Prevents FOUC) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);

          var sidebarCollapsed = localStorage.getItem('sidebar_collapsed');
          if (sidebarCollapsed === 'true') {
            document.documentElement.classList.add('sidebar-collapsed');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts: Google Sans, Inter, JetBrains Mono, Kantumruy Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Kantumruy+Pro:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- KaTeX CSS for Math -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous">

    <!-- MathJax v3 Configuration for Math Readability -->
    <script is:inline>
      window.MathJax = {
        tex: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']],
          processEscapes: true,
          processEnvironments: true
        },
        options: {
          skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
          ignoreHtmlClass: 'katex|katex-display|katex-mathml'
        },
        chtml: {
          fontURL: 'https://cdn.jsdelivr.net/npm/mathjax@3/es5/output/chtml/fonts/woff-v2'
        }
      };
    </script>
    <script is:inline async id="MathJax-script" src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <!-- Interactive Plotly Engine -->
    <script is:inline src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
  </head>
  <body>
    <!-- Reading Progress Bar -->
    <div id="reading-progress-bar" class="reading-progress" aria-hidden="true"></div>

    <div class="app-shell">
      <!-- Persistent Left Sidebar -->
      <Sidebar currentCourse={courseCode} currentLecture={lectureSlug} lang={lang} />

      <!-- Main Column -->
      <div class="main-content-wrapper">
        <MobileTopbar lang={lang} />

        <div class="lecture-page-container">
          <!-- Main Reading Column -->
          <main class="lecture-prose-container" id="main-content">
            <!-- Breadcrumbs Bar -->
            <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
              <button id="lecture-sidebar-toggle-btn" class="sidebar-desktop-toggle-btn" type="button" aria-label="Toggle sidebar" title="Toggle sidebar (Ctrl+B)">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="9" y1="3" x2="9" y2="21"></line>
                </svg>
              </button>

              <a href={`${baseUrl}/`} class="breadcrumb-link">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                </svg>
                <span>Home</span>
              </a>
              <span class="breadcrumb-sep">/</span>
              <a href={`${baseUrl}/courses/${courseCode}/`} class="breadcrumb-link">{courseCode.toUpperCase()}</a>
              <span class="breadcrumb-sep">/</span>
              <span class="breadcrumb-current">{lectureSlug.toUpperCase().replace('-', ' ')}</span>

              <!-- Right Tools: Bookmark, Language switch & Theme Toggle -->
              <div class="lecture-nav-tools">
                <button 
                  id="lecture-bookmark-btn" 
                  class="lecture-bookmark-btn" 
                  type="button" 
                  aria-label="Bookmark lecture" 
                  title="Bookmark this lecture"
                  data-key={bookmarkKey}
                  data-course={courseCode}
                  data-slug={lectureSlug}
                  data-title={lectureTitle}
                  data-url={lectureUrl}
                >
                  <svg class="bm-icon-empty" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <svg class="bm-icon-filled" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <span class="bm-btn-text">Bookmark</span>
                </button>

                {hasKm && (
                  <a 
                    href={lang === 'en' ? `${baseUrl}/km/courses/${courseCode}/${lectureSlug}/` : `${baseUrl}/courses/${courseCode}/${lectureSlug}/`}
                    class="lang-pill-btn"
                    title="Switch Language"
                  >
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                    </svg>
                    <span class={lang === 'en' ? 'khmer-label' : ''}>{lang === 'en' ? 'ភាសាខ្មែរ' : 'English'}</span>
                  </a>
                )}
                <ThemeToggle />
              </div>
            </nav>

            <!-- Lecture Content Body (Markdown compiled) -->
            <article class="lecture-markdown-body" id="lecture-body">
              <slot />
            </article>

            <!-- Bottom Navigation Bar: Prev & Next Lecture -->
            <footer class="lecture-pagination-footer">
              {prevLecture ? (
                <a href={`${baseUrl}/courses/${courseCode}/${prevLecture.slug}/`} class="pagination-btn prev-btn">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                  </svg>
                  <div class="btn-text-block">
                    <span class="btn-sub">PREVIOUS LECTURE</span>
                    <span class="btn-main">{prevLecture.title}</span>
                  </div>
                </a>
              ) : <div />}

              {nextLecture ? (
                <a href={`${baseUrl}/courses/${courseCode}/${nextLecture.slug}/`} class="pagination-btn next-btn">
                  <div class="btn-text-block text-right">
                    <span class="btn-sub">NEXT LECTURE</span>
                    <span class="btn-main">{nextLecture.title}</span>
                  </div>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              ) : <div />}
            </footer>
          </main>

          <!-- Floating Table of Contents (Right Sidebar for Desktop) -->
          {filterHeadings.length > 0 && (
            <aside class="lecture-toc-aside" aria-label="Table of Contents">
              <div class="toc-sticky-wrapper">
                <div class="toc-header">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                  </svg>
                  <span>ON THIS PAGE</span>
                </div>
                <nav class="toc-nav">
                  <ul class="toc-list">
                    {filterHeadings.map((h) => (
                      <li class={`toc-item depth-${h.depth}`}>
                        <a href={`#${h.slug}`} class="toc-link">
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            </aside>
          )}
        </div>
      </div>
    </div>

    <!-- Client Script: Reading Progress, Copy Code, Math Sanitizer & Interactive Plotly Charts -->
    <script is:inline define:vars={{ chartScriptUrl, courseCode, lectureSlug }}>
      // 1. Reading Progress Bar
      window.addEventListener('scroll', () => {
        const docElem = document.documentElement;
        const totalHeight = docElem.scrollHeight - docElem.clientHeight;
        const scrollPercent = totalHeight > 0 ? (docElem.scrollTop / totalHeight) * 100 : 0;
        const bar = document.getElementById('reading-progress-bar');
        if (bar) bar.style.width = scrollPercent + '%';
      }, { passive: true });

      // 2. Plotly Theme Synchronizer (Dark & Light Mode Adaptation)
      function syncPlotlyTheme() {
        if (typeof Plotly === 'undefined') return;
        const theme = document.documentElement.getAttribute('data-theme') || 'light';
        const isDark = theme === 'dark';

        const update = {
          'paper_bgcolor': 'transparent',
          'plot_bgcolor': 'transparent',
          'font.color': isDark ? '#F1F5F9' : '#0F172A',
          'font.family': 'Inter, system-ui, -apple-system, sans-serif',
          'xaxis.gridcolor': isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(15, 23, 42, 0.08)',
          'yaxis.gridcolor': isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(15, 23, 42, 0.08)',
          'xaxis.zerolinecolor': isDark ? 'rgba(255, 255, 255, 0.15)' : 'rgba(15, 23, 42, 0.15)',
          'yaxis.zerolinecolor': isDark ? 'rgba(255, 255, 255, 0.15)' : 'rgba(15, 23, 42, 0.15)',
          'xaxis.tickfont.color': isDark ? '#94A3B8' : '#64748B',
          'yaxis.tickfont.color': isDark ? '#94A3B8' : '#64748B',
          'xaxis.title.font.color': isDark ? '#F1F5F9' : '#0F172A',
          'yaxis.title.font.color': isDark ? '#F1F5F9' : '#0F172A',
          'title.font.color': isDark ? '#F8FAFC' : '#0F172A',
          'legend.bgcolor': isDark ? 'rgba(17, 26, 46, 0.85)' : 'rgba(255, 255, 255, 0.88)',
          'legend.bordercolor': isDark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(15, 23, 42, 0.12)',
          'legend.font.color': isDark ? '#F1F5F9' : '#0F172A'
        };

        document.querySelectorAll('.plotly-chart').forEach((el) => {
          if (el.data) {
            try {
              if (el.layout && el.layout.yaxis2) {
                update['yaxis2.gridcolor'] = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(15, 23, 42, 0.08)';
              }
              Plotly.relayout(el, update);
              Plotly.Plots.resize(el);
            } catch (err) {}
          }
        });
      }

      document.addEventListener('theme:changed', syncPlotlyTheme);
      window.addEventListener('resize', () => {
        if (typeof Plotly === 'undefined') return;
        document.querySelectorAll('.plotly-chart').forEach((el) => {
          if (el.data) {
            try { Plotly.Plots.resize(el); } catch (err) {}
          }
        });
      }, { passive: true });

      // 3. Interactive Chart Enclosure & Dynamic Loader
      function initInteractiveCharts() {
        const chartContainers = document.querySelectorAll('.plotly-chart');
        if (chartContainers.length === 0) return;

        // Wrap each chart container in a Bento visual card frame if not already wrapped
        chartContainers.forEach((el) => {
          if (!el.parentElement.classList.contains('bento-viz-card')) {
            const wrapper = document.createElement('div');
            wrapper.className = 'bento-viz-card';
            
            const header = document.createElement('div');
            header.className = 'viz-header';
            header.innerHTML = `
              <div class="viz-header-left">
                <span class="viz-badge">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                  </svg>
                  Interactive Simulation
                </span>
                <span class="viz-instruction">Pan, Zoom &amp; Hover to inspect values</span>
              </div>
            `;

            el.parentNode.insertBefore(wrapper, el);
            wrapper.appendChild(header);
            wrapper.appendChild(el);
          }
        });

        // Function to trigger chart initialization functions
        const triggerChartRenders = () => {
          // 1. Dispatch custom event for charts listening to markdown:rendered
          document.dispatchEvent(new CustomEvent('markdown:rendered'));

          // 2. Scan window for render functions like renderCs336Lecture3Charts, renderLecture1Charts, etc.
          Object.keys(window).forEach((key) => {
            if (key.startsWith('render') && key.endsWith('Charts') && typeof window[key] === 'function') {
              try {
                window[key]();
              } catch (e) {
                console.warn(`Chart render error in ${key}:`, e);
              }
            }
          });

          // 3. Synchronize theme on initial plot creation
          setTimeout(syncPlotlyTheme, 150);
          setTimeout(syncPlotlyTheme, 400);
        };

        // Dynamically load the lecture-specific chart script
        const existingScript = document.querySelector(`script[src="${chartScriptUrl}"]`);
        if (!existingScript) {
          const script = document.createElement('script');
          script.src = chartScriptUrl;
          script.async = true;
          script.onload = () => {
            triggerChartRenders();
          };
          script.onerror = () => {
            console.info(`No dedicated chart script found at ${chartScriptUrl}`);
          };
          document.body.appendChild(script);
        } else {
          triggerChartRenders();
        }
      }

      // 4. Code Block Copy Button
      function initCodeCopy() {
        document.querySelectorAll('pre').forEach((pre) => {
          if (pre.parentNode && !pre.querySelector('.copy-code-btn')) {
            const btn = document.createElement('button');
            btn.className = 'copy-code-btn';
            btn.setAttribute('aria-label', 'Copy code snippet');
            btn.innerHTML = `
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            `;
            btn.addEventListener('click', async () => {
              const code = pre.querySelector('code')?.innerText || pre.innerText;
              try {
                await navigator.clipboard.writeText(code);
                btn.innerHTML = `
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                `;
                setTimeout(() => {
                  btn.innerHTML = `
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                  `;
                }, 2000);
              } catch (e) {}
            });
            pre.style.position = 'relative';
            pre.appendChild(btn);
          }
        });
      }

      // 5. Lecture Bookmark Sync & Handler
      function initLectureBookmark() {
        const btn = document.getElementById('lecture-bookmark-btn');
        if (!btn) return;

        const key = btn.getAttribute('data-key');
        const course = btn.getAttribute('data-course');
        const slug = btn.getAttribute('data-slug');
        const title = btn.getAttribute('data-title');
        const url = btn.getAttribute('data-url');

        const getBookmarks = () => {
          try {
            const raw = localStorage.getItem('frontier_ai_bookmarks') || localStorage.getItem('stanford_ml_bookmarks');
            return raw ? JSON.parse(raw) : [];
          } catch (e) {
            return [];
          }
        };

        const syncState = () => {
          const list = getBookmarks();
          const bookmarked = list.some(b => b.key === key);
          const textEl = btn.querySelector('.bm-btn-text');
          if (bookmarked) {
            btn.classList.add('is-bookmarked');
            if (textEl) textEl.textContent = 'Saved';
            btn.setAttribute('title', 'Remove from bookmarks');
          } else {
            btn.classList.remove('is-bookmarked');
            if (textEl) textEl.textContent = 'Bookmark';
            btn.setAttribute('title', 'Bookmark this lecture');
          }
        };

        btn.addEventListener('click', () => {
          let list = getBookmarks();
          const idx = list.findIndex(b => b.key === key);
          if (idx !== -1) {
            list.splice(idx, 1);
          } else {
            list.push({ key, course, slug, title, url, timestamp: Date.now() });
          }
          try {
            localStorage.setItem('frontier_ai_bookmarks', JSON.stringify(list));
            localStorage.setItem('stanford_ml_bookmarks', JSON.stringify(list));
            document.dispatchEvent(new CustomEvent('bookmarks:updated', { detail: { bookmarks: list } }));
          } catch (e) {}
          syncState();
        });

        document.addEventListener('bookmarks:updated', syncState);
        window.addEventListener('storage', syncState);
        syncState();
      }

      // 6. DOM Initialization
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initInteractiveCharts();
          initCodeCopy();
          initLectureBookmark();
        });
      } else {
        initInteractiveCharts();
        initCodeCopy();
        initLectureBookmark();
      }
    </script>
  </body>
</html>

<style>
  /* Reading Progress Line */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, #2563EB, #06B6D4);
    width: 0%;
    z-index: 9999;
    transition: width 0.1s ease-out;
  }

  /* Layout Container */
  .lecture-page-container {
    display: flex;
    justify-content: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 2rem 5rem;
    gap: 3rem;
  }

  @media (max-width: 768px) {
    .lecture-page-container {
      padding: 1rem 1rem 3rem;
      gap: 1.5rem;
    }
  }

  .lecture-prose-container {
    flex: 1;
    min-width: 0;
    max-width: 860px;
  }

  /* Breadcrumb Navigation */
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .breadcrumb-nav {
      gap: 0.5rem;
    }

    .lecture-nav-tools {
      width: 100%;
      margin-left: 0;
      justify-content: flex-start;
      padding-top: 0.65rem;
      border-top: 1px dashed var(--border-subtle);
    }
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--brand-accent);
  }

  .breadcrumb-sep {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .breadcrumb-current {
    font-weight: 700;
    color: var(--text-primary);
  }

  .lecture-nav-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .lang-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .lang-pill-btn:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
  }

  .lecture-bookmark-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lecture-bookmark-btn:hover {
    background: var(--card-surface-subtle);
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .lecture-bookmark-btn .bm-icon-filled {
    display: none;
    color: #F59E0B;
  }

  .lecture-bookmark-btn .bm-icon-empty {
    display: block;
  }

  .lecture-bookmark-btn.is-bookmarked {
    border-color: rgba(245, 158, 11, 0.45);
    background: rgba(245, 158, 11, 0.08);
    color: #F59E0B;
  }

